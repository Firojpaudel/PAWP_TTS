# Generic PAWP-TTS Environment Configuration Template
# Copy to `.env` (git-ignored) and set local service URLs and symlink paths.

PAWP_ASR_API_URL=https://asr.example.com/transcribe
PAWP_ASR_BUCKET=string
PAWP_ASR_FILENAME=string
PAWP_ASR_USER_ID=string
PAWP_ASR_ORG=string
PAWP_ASR_SCOPE=string
PAWP_ASR_SERVICE=string
PAWP_ASR_CONTEXT_WORDS=string
PAWP_ASR_TIMEOUT_SEC=30.0

PAWP_DATA_SOURCES_DIR=data/sources
PAWP_TEACHER_DIR=data/sources/teacher

# Experiment tracking (optional)
WANDB_API_KEY=string
WANDB_PROJECT=pawp-tts
PAWP_TTS_API_URL=string
PAWP_MIXED_ASR_PYTHON=string
PAWP_MIXED_ASR_MODEL_DIR=string
PAWP_TTS_VOICE=string
PAWP_TTS_LANG_CODES={"en": "en", "ne": "ne"}
PAWP_TTS_FORM_TEMPLATE={"text": "{text}", "voice": "{voice}", "language": "{lang}"}
PAWP_TARGET_SPEAKER=string
